<% include ../partials/header %>

<div class="padding-30 grid-9 center">
                    <div class="card">
                          
                        <div class="card-header">

                                <% if(msg===''){ %> 
                                   
                                 <%   }  else if (msg==='Successfull'){ %>
                                    <div class="alert alert-success" role="alert">
                                            The Project was added successfully.
                                    </div>
                            
                                 <%   }%>
                            <p>New Project</p>
                            <p class="text">Fill in the following.</p>
                        </div>

                        <div class="card-content">
                            <form id="file-form" action="/add-new"  enctype="multipart/form-data"  method="post">  
                                <!-- <label>Upload Image</label>
                                
                                <img id='img-upload' name='img-upload'/>    
                                <div class="input-group">
                                    <span class="input-group-btn">
                                        <span class="btn btn-default btn-file">
                                            Browse… <input type="file" id="imgInp" name="model_img"  accept="image/*" required>
                                        </span>
                                    </span>
                                    <input type="text" class="form-control"   readonly>
                                </div>     -->

                                <div class="custom-file-container" data-upload-id="myUniqueUploadId">
                                        <label>Upload File <a href="javascript:void(0)" class="custom-file-container__image-clear" title="Clear Image">&times;</a></label>
                             
                                        <label class="custom-file-container__custom-file" >
                                            <input type="file" class="custom-file-container__custom-file__custom-file-input" accept="*" name="model_img"  required aria-label="Choose File">
                                          
                                            <span class="custom-file-container__custom-file__custom-file-control"></span>
                                        </label>
                                        <div class="custom-file-container__image-preview"></div>
                                    </div>
                             

                                <!-- <div class="align-center grid-6">
                                    <img id="thumbnail" src="photos/default.jpg" class="round-corner" width="100%">
                                    <label>
                                        <a class="btn btn-default text-white bg-blue shadow-hover margin-10">
                                            <i class="material-icons" style="position:relative; top:7px;margin-top:-12px;">photo</i> 
                                            Select Image
                                            <input id="fileInput" type="file" name="img" style="display: none;" accept=".jpg, .png">    
                                        </a>
                                    </label>
                                    <p class="text text-blue" id="fileLabel"> </p>
                                    <p class="text">Upload a blueprint or a model for the project</p>
                                </div>   -->
                                <div class="my-row">                              
                                    <div class="my-col-6">
                                        <label class="text">Project Name</label>
                                        <input required type="text" name="proj_name" placeholder="Enter project name.">
                                    </div>
                                    <div class="my-col-6">
                                        <label class="text">Contractor</label>
                                        <input required type="text" name="contractor" placeholder="Enter project contractor.">
                                    </div>
                                </div>
                                <div class="my-row">                                
                                    <div class="my-col-4">
                                        <label class="text">Campus</label>
                                        <select name="campus" required>
                                            <option>Lingayen</option>
                                            <option>Lingayen West</option>
                                            <option>Asingan</option>
                                            <option>Alaminos</option>
                                            <option>Bayambang</option>
                                            <option>Binmaley</option>
                                            <option>Infanta</option>
                                            <option>San Carlos</option>
                                            <option>Sta. Maria</option>
                                            <option>Urdaneta</option>
                                        </select>
                                    </div>
                                    <div class="my-col-4">
                                        <label class="text">Source of Fund</label>
                                         <select name="src_fund" required>
                                            <option>Income</option>
                                            <option>GAA</option>
                                            <option>SVP</option>
                                        </select>
                                    </div>
                                    <div class="my-col-4">
                                        <label class="text">Initial Fund</label>
                                        <input type="number" name="init_fund" required placeholder="Enter initial fund.">
                                    </div>
                                </div>
                                <div class="my-row">                                
                                    <div class="my-col-4">
                                        <label class="text">Note to Proceed</label>
                                        <input type="date" max="" id="start_date" required name="start_date">
                                    </div>
                                    <div class="my-col-4">
                                        <label class="text">Target Date</label>
                                        <input type="date" :min="start_date" required name="target_date">
                                    </div>
                                    <!--
                                    <div class="my-col-4">
                                        <label class="text">Duration</label>
                                        <input type="text" name="duration" @input="validate" :value="duration" disabled>
                                    </div> -->
                                </div>

                                <button class="btn btn-lg text-white  bg-green btn-block text-uppercase" type="submit"> <i class="material-icons" style="position:relative; top:7px;margin-top:-12px;">save</i>  SAVE PROJECT</button>
                            </form>
                        </div>

                    </div>
                </div>  
<% include ../partials/footer %>