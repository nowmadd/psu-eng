  <label class="custom-control-label" for="customCheck1">Remember password</label>
</div> -->
<button class="btn btn-lg btn-primary btn-block text-uppercase" type="submit">SAVE ACCOUNT</button>
<hr class="my-4">



</form>



<% include ../partials/footer %>