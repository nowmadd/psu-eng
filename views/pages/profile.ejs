<% include ../partials/header %>
<div class="padding-30 grid-9 center">
<div class="card">
    <div class="card-header">
        <p>Profile</p>
        <p class="text"><%= profile.username %>'s information</p>
    </div>

    <div class="card-content">
        <p class="text"><b>Username:</b> <%= profile.username %></p>
        <p class="text"><b>Campus:</b> <%= profile.campus %></p>
        <p class="text"><b>Full Name:</b> <%= profile.f_name +  ' ' +profile.m_name + ' ' +profile.l_name %></p>
        <p class="text"><b>User Type:</b> <%= profile.type %></p>
    </div>
</div>
</div> 

<% include ../partials/footer %>