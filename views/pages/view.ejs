                          <div class="modal" id="addActivity" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                              <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                  <div class="modal-header">
                                    <h5 class="modal-title" id="exampleModalLongTitle">Add New Activity</h5>
                                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                      <span aria-hidden="true">&times;</span>
                                    </button>
                                  </div>
                                  <div class="modal-body">
                                      <form  action="/add-activity" method="post">
                                      <div class="form-group">
                                        <label for="name">Activity Title</label>
                                        <input  required type="text" name="text"class="form-control" id="name" aria-describedby="name" placeholder="">
                                      </div>
                                      <div class="form-group">
                                        <label for="start_date">Start Date</label>
                                        <input required type="date" name="start_date" class="form-control" min="<%= project.start_date %>" id="start_date" placeholder="">
                                      </div>

                                      <div class="form-group">
                                        <label for="target_date">Target Date</label>
                                        <input  required type="date" name="target_date" class="form-control" min="<%= project.start_date %>" id="target_date" placeholder="">
                                      </div>

                                      <div class="form-group">
                                        <label for="parent">Phase</label>
                                        <select name="parent" required>
                                            <option value="1">PHASE 1</option>
                                            <option value="12">PHASE 2</option>
                                            <option value="17">PHASE 3</option>
                                            <option value="21">PHASE 4</option>
                                        </select>
                                      </div>
                                      <input type="hidden" name="proj_id" value="<%= project.proj_id %>">




                                  </div>
                                  <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                  </div>
                                </form>
                                </div>
                              </div>
                            </div>


                            <div id="myModal" class="modal-gallery">
                                <span class="close cursor" onclick="closeModal()">&times;</span>
                                <div class="modal-gallery-content">
                              
                                    <% if(gallery.length > 0) { gallery.forEach(function(image, index){ %>
                                    <div class="mySlides">
                                    <div class="numbertext"> <%= index %></div>
                                    <img src="../../<%= image.dir %>" style="width:100%">
                                    </div>
                                    <% }); } %>
                              
                                  <!-- Next/previous controls -->
                                  <a class="prev" onclick="plusSlides(-1)">&#10094;</a>
                                  <a class="next" onclick="plusSlides(1)">&#10095;</a>
                              
                                  <!-- Caption text -->
                                  <div class="caption-container">
                                    
                                  </div>
                                  <% if(gallery.length > 0) { gallery.forEach(function(image, index){ %>
                                  <!-- Thumbnail image controls -->
                                  <div class="column">
                                    <img class="demo" src="../../<%= image.dir %>" onclick="currentSlide(index)">
                                  </div>
                                  <% }); } %>
                                </div>
                              </div>

                            

  <p id="yy"style="display:none"><%= tasks %></p>

  <div id="gantt_here" class="padding-20" style='width:97%; height:80%;'></div><BR><BR>



  <script type="text/javascript">
 
  var x= document.getElementById("yy").innerText
 gantt.config.xml_date = "%Y-%m-%d %H:%i:%s";
 gantt.config.readonly= true;



 gantt.config.columns = [
  {name: "text", label: "Activity Name", tree: true, width: 300, "resize": true, min_width: 10},
  {name: "start_date", align: "center", width: 90, "resize": true},
  {name: "duration", align: "center", width: 80, "resize": true},
  
];




	gantt.config.scale_height = 50;





  gantt.init("gantt_here");
  gantt.parse(x);
  </script>

<script>
    // Open the Modal
    function openModal() {
      document.getElementById('myModal').style.display = "block";
    }
    
    // Close the Modal
    function closeModal() {
      document.getElementById('myModal').style.display = "none";
    }
    
    var slideIndex = 1;
    showSlides(slideIndex);
    
    // Next/previous controls
    function plusSlides(n) {
      showSlides(slideIndex += n);
    }
    
    // Thumbnail image controls
    function currentSlide(n) {
      showSlides(slideIndex = n);
    }
    
    function showSlides(n) {
      var i;
      var slides = document.getElementsByClassName("mySlides");
      var dots = document.getElementsByClassName("demo");
      var captionText = document.getElementById("caption");
      if (n > slides.length) {slideIndex = 1}
      if (n < 1) {slideIndex = slides.length}
      for (i = 0; i < slides.length; i++) {
        slides[i].style.display = "none";
      }
      for (i = 0; i < dots.length; i++) {
        dots[i].className = dots[i].className.replace(" active", "");
      }
      slides[slideIndex-1].style.display = "block";
      dots[slideIndex-1].className += " active";
      captionText.innerHTML = dots[slideIndex-1].alt;
    }
    </script>
